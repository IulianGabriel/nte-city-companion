{
  "name": "nte-city-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply nte-city-companion --remote"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "wrangler": "^4.148.0"
  }
}
